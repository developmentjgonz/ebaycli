{
  "name": "@ebaycli/relay",
  "version": "0.1.0",
  "private": true,
  "description": "Deployment-owned eBay OAuth relay for Cloudflare Workers",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply AUTH_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply AUTH_DB --remote",
    "deploy": "wrangler deploy"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^24.7.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  }
}
